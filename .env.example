# Threat Hunt Lab - Environment Variables Template
# Copy this file to .env and fill in your values
# cp .env.example .env

# Splunk Configuration
# Password must meet Splunk requirements: 8+ chars, upper, lower, number, special
SPLUNK_PASSWORD=ChangeMe_StrongPass123!

# Caldera Configuration
# Default admin password for Caldera (change in production)
CALDERA_ADMIN_PASSWORD=ChangeMe_CalderaAdmin123!

# Optional: Splunk License (if you have one)
# SPLUNK_LICENSE_URI=https://your-license-server:8000

# Optional: External reverse proxy / TLS
# TRAEFIK_DOMAIN=threathunt.local